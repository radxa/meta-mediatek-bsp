/dts-v1/;
/plugin/;

/ {
	fragment@0 {
		target = <&ethernet>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@1 {
		target = <&dpi0>;
		__overlay__ {
			pinctrl-names = "";
		};
	};

	fragment@2 {
		target = <&dpi_default_pins>;
		__overlay__ {
			status = "disabled";
		};
	};

	fragment@3 {
		target = <&dpi_idle_pins>;
		__overlay__ {
			status = "disabled";
		};
	};
};
