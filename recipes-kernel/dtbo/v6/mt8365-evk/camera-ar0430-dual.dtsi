#include <dt-bindings/clock/mediatek,mt8365-clk.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/mt8365-pinfunc.h>

/dts-v1/;
/plugin/;

/ {
	fragment@0 {
		target-path = "/";
		__overlay__ {
			cam0_pdn: cam0-pdn-regulator {
				compatible = "regulator-fixed";
				regulator-name = "cam0_pdn";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				gpio = <&pio 105 GPIO_ACTIVE_HIGH>;
				startup-delay-us = <18000>;
				enable-active-high;
			};

			cam1_pdn: cam1-pdn-regulator {
				compatible = "regulator-fixed";
				regulator-name = "cam1_pdn";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				gpio = <&pio 107 GPIO_ACTIVE_HIGH>;
				startup-delay-us = <18000>;
				enable-active-high;
			};

			vcama_reg: vcama-regulator {
				compatible = "regulator-fixed";
				regulator-name = "vcama_dummy_regulator";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
			};

			vcamd_reg: vcamd-regulator {
				compatible = "regulator-fixed";
				regulator-name = "vcamd_dummy_regulator";
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <1000000>;
			};
		};
	};

	fragment@1 {
		target = <&pio>;
		__overlay__ {
			cam0_pins_default: cam0_pins_default {
				pins_clk_rst {
					pinmux = <MT8365_PIN_65_CMMCLK0__FUNC_CMMCLK0>,
						 <MT8365_PIN_105_NCLE__FUNC_GPIO105>,
						 <MT8365_PIN_106_NCEB1__FUNC_GPIO106>;
				};
			};

			cam1_pins_default: cam1_pins_default {
				pins_clk_rst {
					pinmux = <MT8365_PIN_66_CMMCLK1__FUNC_CMMCLK1>,
						 <MT8365_PIN_107_NCEB0__FUNC_GPIO107>,
						 <MT8365_PIN_108_NREB__FUNC_GPIO108>;
				};
			};
		};
	};

	fragment@2 {
		target = <&i2c2>;
		__overlay__ {
			clock-frequency = <400000>;

			sensor@36 { /* Rear camera */
				compatible = "onnn,ar0430";
				reg = <0x36>;
				status = "okay";

				pinctrl-names = "default";
				pinctrl-0 = <&cam0_pins_default>;

				clocks = <&topckgen CLK_TOP_CAMTG_SEL>;
				assigned-clocks = <&topckgen CLK_TOP_CAMTG_SEL>;
				assigned-clock-parents = <&topckgen CLK_TOP_USB20_192M_D8>;
				clock-frequency = <24000000>;

				reset-gpios = <&pio 106 GPIO_ACTIVE_LOW>;

				vaa-supply =   <&vcama_reg>;
				vddio-supply = <&cam0_pdn>;
				vdd-supply =   <&vcamd_reg>;

				port {
					ar0430_1_endpoint: endpoint {
						remote-endpoint = <&seninf_in1>;
						data-lanes = <1 2 3 4>;
					};
				};
			};
		};
	};

	fragment@3 {
		target = <&i2c3>;
		__overlay__ {
			clock-frequency = <400000>;

			sensor@36 { /* Front camera */
				compatible = "onnn,ar0430";
				reg = <0x36>;
				status = "okay";

				pinctrl-names = "default";
				pinctrl-0 = <&cam1_pins_default>;

				clocks = <&topckgen CLK_TOP_CAMTG1_SEL>;
				assigned-clocks = <&topckgen CLK_TOP_CAMTG1_SEL>;
				assigned-clock-parents = <&topckgen CLK_TOP_USB20_192M_D8>;
				clock-frequency = <24000000>;

				reset-gpios = <&pio 108 GPIO_ACTIVE_LOW>;

				vaa-supply =   <&vcama_reg>;
				vddio-supply = <&cam1_pdn>;
				vdd-supply =   <&vcamd_reg>;

				port {
					ar0430_2_endpoint: endpoint {
						remote-endpoint = <&seninf_in2>;
						data-lanes = <1 2 3 4>;
					};
				};
			};
		};
	};

	fragment@4 {
		target = <&seninf>;
		__overlay__ {
			status = "okay";

			ports {
				port@0 {
					seninf_in1: endpoint {
						clock-lanes = <2>;
						data-lanes = <1 3 0 4>;
						remote-endpoint = <&ar0430_1_endpoint>;
					};
				};

				port@1 {
					seninf_in2: endpoint {
						clock-lanes = <2>;
						data-lanes = <1 3 0 4>;
						remote-endpoint = <&ar0430_2_endpoint>;
					};
				};
			};
		};
	};

	fragment@5 {
		target = <&camsv1>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@6 {
		target = <&camsv2>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@7 {
		target = <&mipi_csi0>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@8 {
		target = <&mipi_csi1>;
		__overlay__ {
			status = "okay";
		};
	};
};
