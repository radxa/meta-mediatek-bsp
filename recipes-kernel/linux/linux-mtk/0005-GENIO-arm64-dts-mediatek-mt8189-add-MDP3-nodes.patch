From: Moudy Ho <moudy.ho@mediatek.com>
Date: Mon, 8 Sep 2025 10:56:56 +0800
Subject: [PATCH 5/9] GENIO: arm64: dts: mediatek: mt8189: add MDP3 nodes

Add device nodes for Media Data Path 3 (MDP3) modules.

Change-Id: I6e90e6bb69d439d44e7fe72b49fec1a8ced232cb
Signed-off-by: Moudy Ho <moudy.ho@mediatek.com>
---
 arch/arm64/boot/dts/mediatek/mt8189.dtsi | 211 +++++++++++++++++++++++
 1 file changed, 211 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt8189.dtsi b/arch/arm64/boot/dts/mediatek/mt8189.dtsi
index b487acbbcb5b..408862683e41 100644
--- a/arch/arm64/boot/dts/mediatek/mt8189.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt8189.dtsi
@@ -3083,5 +3083,216 @@ camsv7_seninf1_endpoint: endpoint {
 				};
 			};
 		};
+
+		mutex1: mdp-mutex0@1f001000 {
+			compatible = "mediatek,mt8189-mdp-mutex";
+			reg = <0 0x1f001000 0 0x1000>;
+			clocks = <&mdpsys_config_clk CLK_MDP_MUTEX0>;
+			power-domains = <&scpsys MT8189_POWER_DOMAIN_MDP0>;
+		};
+
+		dma-controller@1f003000 {
+			compatible = "mediatek,mt8189-mdp3-rdma";
+			reg = <0 0x1f003000 0 0x1000>;
+			mediatek,gce-client-reg = <&gce0 SUBSYS_NO_SUPPORT 0x3000 0x1000>;
+			mediatek,gce-events = <CMDQ_EVENT_MMLSYS_MDP_RDMA0_SOF>,
+					      <CMDQ_EVENT_MMLSYS_MDP_RDMA0_FRAME_DONE>;
+			power-domains = <&scpsys MT8189_POWER_DOMAIN_MDP0>;
+			iommus = <&mm_iommu M4U_L2_P0_MDP_RDMA0>;
+			clocks = <&mdpsys_config_clk CLK_MDP_RDMA0>,
+				 <&mdpsys_config_clk CLK_MDPSYS_CONFIG>;
+			mboxes = <&gce0 16 CMDQ_THR_PRIO_1>,
+				 <&gce0 17 CMDQ_THR_PRIO_1>,
+				 <&gce0 18 CMDQ_THR_PRIO_1>;
+			#dma-cells = <1>;
+		};
+
+		dma-controller@1f004000 {
+			compatible = "mediatek,mt8189-mdp3-rdma";
+			reg = <0 0x1f004000 0 0x1000>;
