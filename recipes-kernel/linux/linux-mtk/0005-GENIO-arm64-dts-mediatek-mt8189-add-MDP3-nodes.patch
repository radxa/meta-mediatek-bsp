+					      <CMDQ_EVENT_MMLSYS_MDP_RDMA1_FRAME_DONE>;
+			power-domains = <&scpsys MT8189_POWER_DOMAIN_MDP0>;
+			iommus = <&mm_iommu M4U_L2_P1_MDP_RDMA1>;
+			clocks = <&mdpsys_config_clk CLK_MDP_RDMA1>;
+			#dma-cells = <1>;
+		};
+
+		display@1f005000 {
