+	(a)->bias_x_c = (b)->bias_x_c; \
+	(a)->offset_x_c = (b)->offset_x_c; \
+	/* diff view tdr used with backup */ \
+	(a)->backward_tdr_h_disable_flag = (b)->backward_tdr_h_disable_flag; \
+	/* diff view tdr used with backup */ \
+	(a)->backward_h_end_flag = (b)->backward_h_end_flag; \
