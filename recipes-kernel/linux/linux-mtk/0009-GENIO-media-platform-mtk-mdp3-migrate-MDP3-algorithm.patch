+                                        if ((TILE_TYPE_CROP_EN & ptr_func->type) && (0x0 == (ptr_func->type & TILE_TYPE_LOSS)) &&
+                                                ptr_func->enable_flag)
+                                        {
+                                                ptr_func->tdr_edge |= TILE_EDGE_BOTTOM_MASK;
