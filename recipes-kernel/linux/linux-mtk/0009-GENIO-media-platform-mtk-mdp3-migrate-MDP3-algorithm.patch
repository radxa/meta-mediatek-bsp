+	/* diff view cal, to reset */ \
+	(b)->tdr_h_disable_flag = (a)->tdr_h_disable_flag; \
+	(b)->h_end_flag = (a)->h_end_flag; \
+	(b)->in_pos_xs = (a)->in_pos_xs; \
+	(b)->in_pos_xe = (a)->in_pos_xe; \
+	/* backward boundary for ufd smt */ \
+	(b)->out_pos_xs = (a)->out_pos_xs; \
