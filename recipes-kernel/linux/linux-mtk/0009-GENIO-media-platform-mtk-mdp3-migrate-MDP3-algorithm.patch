+                                {
+                                        /* end of tile */
+                                        ptr_func->h_end_flag = true;
+                                }
+                        }
+                        else/* direct link */
+                        {
+                                if (false == ptr_func->tdr_h_disable_flag)
+                                {
+                                        /* copy from min tile config */
+                                        ptr_func->out_pos_xs = ptr_func->min_tile_out_pos_xs;
