+                        /* backup backward */
+                        ptr_func->backward_input_ys_pos = ptr_func->in_pos_ys;
+                        ptr_func->backward_input_ye_pos = ptr_func->in_pos_ye;
+                        ptr_func->backward_output_ys_pos = ptr_func->out_pos_ys;
