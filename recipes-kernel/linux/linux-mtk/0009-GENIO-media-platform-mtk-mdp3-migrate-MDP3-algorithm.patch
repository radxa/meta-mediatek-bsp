+                        }
+                        else
+                        {
+                                ptr_func->tdr_edge &= ~TILE_EDGE_BOTTOM_MASK;
+                        }
+                        /* update output top edge */
+                        if (ptr_func->out_pos_ys > 0)
+                        {
+                                ptr_func->tdr_edge &= ~TILE_EDGE_TOP_MASK;
+                        }
+                        else
+                        {
+                                ptr_func->tdr_edge |= TILE_EDGE_TOP_MASK;
+                        }
+                }
+    }
+    return TILE_MSG_OK;
+}
