+#define has_alg_op(_comp, op) \
+	(_comp->alg_ops && _comp->alg_ops->op)
+#define call_alg_op(_comp, op, ...) \
+	(has_alg_op(_comp, op) ? \
+		_comp->alg_ops->op(__VA_ARGS__) : 0)
+
+struct mdp_dev;
